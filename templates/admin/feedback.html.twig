{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}{{ 'koh_poppy.admin.feedback.title'|trans }} | {{ parent() }}{% endblock %}

{% block body %}
<div class="page-wrapper">
    <div class="page-header d-print-none">
        <div class="container-xl">
            <h1 class="page-title">{{ 'koh_poppy.admin.feedback.title'|trans }}</h1>
            <p class="text-secondary">{{ 'koh_poppy.admin.feedback.intro'|trans }}</p>
        </div>
    </div>
    <div class="page-body">
        <div class="container-xl">
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'koh_poppy.admin.feedback.received'|trans }}</th>
                                <th scope="col">{{ 'koh_poppy.admin.feedback.task'|trans }}</th>
                                <th scope="col">{{ 'koh_poppy.admin.feedback.description'|trans }}</th>
                                <th scope="col">{{ 'koh_poppy.admin.feedback.agent'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for report in reports %}
                                <tr>
                                    <td class="text-nowrap">{{ report.received_at|date('d.m.Y H:i') }}</td>
                                    <td>{{ report.task }}{% if report.kind != 'missing' %} <span class="badge">{{ report.kind }}</span>{% endif %}</td>
                                    <td class="text-wrap" style="max-width: 40rem;">{{ report.description }}</td>
                                    <td class="small">{{ report.client_id }}{% if report.signed_in %} · {{ 'koh_poppy.admin.feedback.signed_in'|trans }}{% endif %}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="text-secondary">{{ 'koh_poppy.admin.feedback.none'|trans }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
