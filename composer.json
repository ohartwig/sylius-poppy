{
    "name": "koh/sylius-poppy",
    "description": "Personal Agent Protocol (Poppy) for Sylius: poppy.json, a per-channel issuer, customer Direct and Device Sign-In, browser sessions, DPoP Session Tokens on the Shop API, and agent feedback.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "poppy",
        "personal-agent-protocol",
        "ai-agent",
        "oauth",
        "dpop"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source/sylius-agent-ready",
    "support": {
        "issues": "https://github.com/ohartwig/sylius-poppy/issues",
        "source": "https://github.com/ohartwig/sylius-poppy"
    },
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^3.10 || ^4.0",
        "doctrine/migrations": "^3.9.8",
        "koh/poppy": "^1.1",
        "koh/sylius-agent-contracts": "^1.1",
        "nyholm/psr7": "^1.8.2",
        "psr/cache": "^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0.3",
        "psr/http-message": "^1.1 || ^2.0",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/clock": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/psr-http-message-bridge": "^7.4 || ^8.0",
        "symfony/rate-limiter": "^7.4 || ^8.1",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.4 || ^8.0",
        "symfony/security-http": "^7.4 || ^8.0",
        "twig/twig": "^3.30.0"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.3",
        "phpunit/phpunit": "^11.5.57"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusPoppy\\": "src/",
            "Koh\\SyliusPoppy\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusPoppy\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
